# ============================================================================
# UrbanStore Environment Variables
# Copy ke .env (lokal) dan masukkan juga di Vercel -> Project Settings -> Env Vars
# ============================================================================

# Supabase Configuration (Client-safe public credentials)
SUPABASE_PROJECT_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Supabase Server Secret (HANYA di server / Vercel Env Vars, JANGAN pakai prefix VITE_)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Mayar.id Payment Gateway (Server-only, JANGAN pakai prefix VITE_)
# Ambil API Key (Read & Write) di https://web.mayar.id/api-keys (production) atau https://web.mayar.io/api-keys (sandbox)
MAYAR_API_KEY="your-mayar-api-key"
# Gunakan "sandbox" untuk testing (api.mayar.io/hl/v2) atau "production" untuk live (api.mayar.id/hl/v2)
MAYAR_ENV="sandbox"
# Opsional override base URL (default otomatis sesuai MAYAR_ENV)
# MAYAR_BASE_URL="https://api.mayar.io/hl/v2"
# Secret token untuk verifikasi webhook URL: https://domainmu.vercel.app/api/mayar/webhook?token=SECRET_INI
MAYAR_WEBHOOK_TOKEN="buat-token-acak-yang-kuat-di-sini"

# Opsional fallback jika dijalankan di luar browser context (default otomatis pakai window.location.origin)
# VITE_APP_URL="https://urbanstore-vcb.vercel.app"

# Gemini AI Keys (Customer Stylist & Admin Assistant)
CS_GEMINI_API_KEY="your-customer-ai-gemini-key"
ADMIN_GEMINI_API_KEY="your-admin-ai-gemini-key"

# Catatan Penting Google OAuth:
# Google Client ID dan Client Secret JANGAN ditaruh di .env frontend!
# Masukkan Client ID & Client Secret di:
# Supabase Dashboard -> Authentication -> Providers -> Google
